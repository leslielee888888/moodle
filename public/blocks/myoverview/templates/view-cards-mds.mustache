{{!
    @template block_myoverview/view-cards-mds

    MDS course card variant of the cards view for the myoverview block. This is the default cards
    view (see GitHub issues #1 and #3): block_myoverview/view.js picks block_myoverview/view-cards
    instead of this template only when the mds_coursecard cookie is exactly "0". It keeps the same
    Bootstrap grid and card-deck region as block_myoverview/view-cards, but mounts a single Course
    card list (core_course/CourseCardList, see GitHub issues #14 and #10, parent #11) that renders
    the grid and a Course card wrapper (core_course/CourseCard, an adapter onto the design
    system's CourseCard) per course, instead of one React root per course.

    The core fields are wired up per course: title, image, subtitle (category or short name), the
    hidden badge, the progress bar, the "Continue learning" footer link, and the
    data-region/data-course-id hooks. The list-item role sits on the grid cell around each card,
    since an article element cannot take it. The action menu and favourite star are intentionally
    dropped (see GitHub issue #1). The "Continue learning" and "Hidden from students" strings are
    shared by every card and are sent once, in props.strings; the per-course progress percentage
    string is still resolved per course, since it differs for each one.

    Mustache has no built-in way to separate repeated items in a JSON array with commas (there is
    no "not last" primitive for a plain array section): each course here carries an `islast` flag
    (set by block_myoverview/view.js) so every course but the last is followed by a comma.

    Each React mount point's fallback content is a static grid of Course card skeletons (see
    GitHub issue #5 and GLOSSARY.md), one per course, shown until the Course card list mounts and
    replaces the whole grid. It is aria-hidden, and a visually hidden loading message immediately
    precedes the mount point instead.

    Example context (json):
    {
        "courses": [
            {
                "id": 2,
                "viewurl": "https://moodlesite/course/view.php?id=2",
                "courseimage": "https://moodlesite/pluginfile/123/course/overviewfiles/123.jpg",
                "fullname": "Course 3 for \"Statistical and Computational Tools\" ",
                "shortname": "stats3",
                "hasprogress": true,
                "progress": 10,
                "coursecategory": "Category 1",
                "showcoursecategory": true,
                "showshortname": false,
                "visible": true,
                "islast": false
            },
            {
                "id": 3,
                "viewurl": "https://moodlesite/course/view.php?id=3",
                "courseimage": "https://moodlesite/pluginfile/124/course/overviewfiles/124.jpg",
                "fullname": "Introduction to Hidden Courses",
                "shortname": "hidden1",
                "hasprogress": false,
                "progress": null,
                "coursecategory": "Category 2",
                "showcoursecategory": true,
                "showshortname": false,
                "visible": false,
                "islast": true
            }
        ]
    }
}}
<span class="visually-hidden">{{#str}} loading {{/str}}</span>
{{#react}}
{
    "component": "@moodle/lms/core_course/CourseCardList",
    "props": {
        "strings": {
            "continuelearning": {{#quote}}{{#str}}continuelearning, block_myoverview{{/str}}{{/quote}},
            "hiddenfromstudents": {{#quote}}{{#str}}hiddenfromstudents{{/str}}{{/quote}}
        },
        "courses": [
        {{#courses}}
            {
                "id": {{id}},
                "fullname": {{#quote}}{{{fullname}}}{{/quote}},
                "shortname": {{#quote}}{{{shortname}}}{{/quote}},
                "viewurl": {{#quote}}{{{viewurl}}}{{/quote}},
                "courseimage": {{#quote}}{{{courseimage}}}{{/quote}},
                "hasprogress": {{#hasprogress}}true{{/hasprogress}}{{^hasprogress}}false{{/hasprogress}},
                "progress": {{^hasprogress}}null{{/hasprogress}}{{#hasprogress}}{{^progress}}0{{/progress}}{{#progress}}{{progress}}{{/progress}}{{/hasprogress}},
                "visible": {{#visible}}true{{/visible}}{{^visible}}false{{/visible}},
                "coursecategory": {{#quote}}{{{coursecategory}}}{{/quote}},
                "showcoursecategory": {{#showcoursecategory}}true{{/showcoursecategory}}{{^showcoursecategory}}false{{/showcoursecategory}},
                "showshortname": {{#showshortname}}true{{/showshortname}}{{^showshortname}}false{{/showshortname}},
                "completepercent": {{^hasprogress}}null{{/hasprogress}}{{#hasprogress}}{{#quote}}{{#str}}completepercent, block_myoverview, {{progress}}{{/str}}{{/quote}}{{/hasprogress}}
            }{{^islast}},{{/islast}}
        {{/courses}}
        ]
    }
}
<div class="card-grid row gx-2 row-cols-1 row-cols-sm-2 row-cols-lg-3" data-region="card-deck" role="list">
{{#courses}}
    <div class="col d-flex mb-2" role="listitem">
        {{> block_myoverview/placeholder-course-mds }}
    </div>
{{/courses}}
</div>
{{/react}}
