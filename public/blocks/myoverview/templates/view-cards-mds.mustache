{{!
    @template block_myoverview/view-cards-mds

    MDS course card variant of the cards view for the myoverview block. This is a proof of
    concept (see GitHub issues #1 and #3): block_myoverview/view.js picks this template instead
    of block_myoverview/view-cards when the mds_coursecard cookie is "1". It keeps the same
    Bootstrap grid and card-deck region as block_myoverview/view-cards, but mounts the Course
    card wrapper (core_course/CourseCard, an adapter onto the design system's CourseCard) for
    each course instead of the existing core_course/coursecard template.

    The core fields are wired up: title, image, subtitle (category or short name), the hidden
    badge, the progress bar, the "Continue learning" footer link, and the
    data-region/data-course-id/role hooks. The action menu and favourite star are intentionally
    dropped (see GitHub issue #1).

    Example context (json):
    {
        "courses": [
            {
                "id": 2,
                "viewurl": "https://moodlesite/course/view.php?id=2",
                "courseimage": "https://moodlesite/pluginfile/123/course/overviewfiles/123.jpg",
                "fullname": "Course 3 for \"Statistical and Computational Tools\" ",
                "shortname": "stats3",
                "hasprogress": true,
                "progress": 10,
                "coursecategory": "Category 1",
                "showcoursecategory": true,
                "showshortname": false,
                "visible": true
            }
        ]
    }
}}
<div class="card-grid row gx-2 row-cols-1 row-cols-sm-2 row-cols-lg-3" data-region="card-deck" role="list">
{{#courses}}
    <div class="col d-flex mb-2">
        {{#react}}
        {
            "component": "@moodle/lms/core_course/CourseCard",
            "class": "w-100",
            "props": {
                "id": {{id}},
                "fullname": {{#quote}}{{{fullname}}}{{/quote}},
                "shortname": {{#quote}}{{{shortname}}}{{/quote}},
                "viewurl": {{#quote}}{{{viewurl}}}{{/quote}},
                "courseimage": {{#quote}}{{{courseimage}}}{{/quote}},
                "hasprogress": {{#hasprogress}}true{{/hasprogress}}{{^hasprogress}}false{{/hasprogress}},
                "progress": {{^hasprogress}}null{{/hasprogress}}{{#hasprogress}}{{progress}}{{/hasprogress}},
                "visible": {{#visible}}true{{/visible}}{{^visible}}false{{/visible}},
                "coursecategory": {{#quote}}{{{coursecategory}}}{{/quote}},
                "showcoursecategory": {{#showcoursecategory}}true{{/showcoursecategory}}{{^showcoursecategory}}false{{/showcoursecategory}},
                "showshortname": {{#showshortname}}true{{/showshortname}}{{^showshortname}}false{{/showshortname}},
                "strings": {
                    "continuelearning": {{#quote}}{{#str}}continuelearning, block_myoverview{{/str}}{{/quote}},
                    "hiddenfromstudents": {{#visible}}null{{/visible}}{{^visible}}{{#quote}}{{#str}}hiddenfromstudents{{/str}}{{/quote}}{{/visible}},
                    "completepercent": {{^hasprogress}}null{{/hasprogress}}{{#hasprogress}}{{#quote}}{{#str}}completepercent, block_myoverview, {{progress}}{{/str}}{{/quote}}{{/hasprogress}}
                }
            }
        }
        {{/react}}
    </div>
{{/courses}}
</div>
