{{!
    @template block_myoverview/placeholder-course-mds

    This template renders the Course card skeleton: a placeholder shaped like the MDS course card
    (image, title, subtitle, progress bar and link lines). It is used as the loading placeholder of
    the My courses cards view and as the fallback shown until the Course card wrapper mounts.
    It carries no braces so it is safe inside a React mount point's fallback content.
    Styles live in block_myoverview/styles.css.

    Example context (json):
    {}
}}
<div class="mds-course-card-skeleton w-100 h-100" aria-hidden="true">
    <div class="mds-course-card-skeleton-image"></div>
    <div class="mds-course-card-skeleton-content">
        <div class="mds-course-card-skeleton-header">
            <div class="mds-course-card-skeleton-text">
                <div class="mds-course-card-skeleton-line mds-course-card-skeleton-title"></div>
                <div class="mds-course-card-skeleton-line mds-course-card-skeleton-subtitle"></div>
            </div>
        </div>
        <div class="mds-course-card-skeleton-line mds-course-card-skeleton-progress"></div>
        <div class="mds-course-card-skeleton-line mds-course-card-skeleton-link"></div>
    </div>
</div>
